#include <stdio.h>

/*Faça um Procedimento em algoritmo que recebe como parâmetro um inteiro
no intervalo de 1 a 9 e mostre a seguinte tabela de multiplicação*/

void imprimirTabelaMultiplicacao(int numero);

int main() {
    int numero;

    printf("Digite um número inteiro de 1 a 9: ");
    scanf("%d", &numero);

    imprimirTabelaMultiplicacao(numero);

    return 0;
}

void imprimirTabelaMultiplicacao(int numero) {
    for (int i = 1; i <= 10; i++) {
        printf("%d x %d = %d\n", numero, i, numero * i);
    }
}